#!/bin/bash

set -u

CMD_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck disable=SC1091
. "${CMD_DIR}/common"

BIN="${TRIM_APPDEST}/bin/fnos-bridge"
STATE_FILE="${TRIM_PKGVAR}/fnos-music/guid-map.json"

start_app() {
    if status_app; then
        return 0
    fi
    if [ ! -x "${BIN}" ]; then
        echo "未找到可执行文件：${BIN}" > "${TRIM_TEMP_LOGFILE}"
        return 1
    fi
    if ! wait_for_official_music; then
        echo "等待飞牛音乐 Socket 超时，请先启动官方飞牛音乐。" > "${TRIM_TEMP_LOGFILE}"
        log_msg "Official fnOS Music socket did not appear"
        return 1
    fi

    load_profile
    write_default_profile
    load_profile
    if ! wait_for_source_api; then
        echo "等待 go-music-dl source API 超时，请先启动 go-music-dl 应用。" > "${TRIM_TEMP_LOGFILE}"
        log_msg "go-music-dl source API did not appear"
        return 1
    fi
    mkdir -p "${TRIM_PKGVAR}/fnos-music"
    chmod 0700 "${TRIM_PKGVAR}/fnos-music"

    local args=(
        --state-file "${STATE_FILE}"
        --source-socket "${FNMUSIC_SOURCE_SOCKET}"
        --sources "${FNMUSIC_SOURCES:-netease,qq,kugou,kuwo,migu}"
        --max-online "${FNMUSIC_MAX_ONLINE:-30}"
        --search-timeout "${FNMUSIC_SEARCH_TIMEOUT:-12s}"
        --socket-mode "${FNMUSIC_SOCKET_MODE:-0666}"
        --target-socket "${TARGET_SOCKET}"
        --upstream-socket "/var/run/trim_music_upstream.socket"
    )

    log_msg "Starting go-music-dl fnOS Music bridge"
    cd "${TRIM_PKGVAR}" || return 1
    "${BIN}" "${args[@]}" >> "${LOG_FILE}" 2>&1 &
    local pid=$!
    printf "%s" "${pid}" > "${PID_FILE}"

    local waited=0
    while [ "${waited}" -lt 30 ]; do
        if ! check_process "${pid}"; then
            echo "go-music-dl 飞牛音乐桥启动失败，请查看 ${LOG_FILE}" > "${TRIM_TEMP_LOGFILE}"
            rm -f "${PID_FILE}"
            return 1
        fi
        if command -v curl >/dev/null 2>&1 &&
            curl -fsS --max-time 2 \
                --unix-socket "${TARGET_SOCKET}" \
                "http://localhost/_ext/fnos-go-music-dl/healthz" \
                | grep -q '"ok":true'; then
            log_msg "Bridge ready (pid=${pid})"
            return 0
        fi
        sleep 1
        waited=$((waited + 1))
    done

    echo "go-music-dl 飞牛音乐桥健康检查超时，请查看 ${LOG_FILE}" > "${TRIM_TEMP_LOGFILE}"
    kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1 || true
    rm -f "${PID_FILE}"
    return 1
}

stop_app() {
    log_msg "Stopping go-music-dl fnOS Music bridge"
    local pid
    pid="$(read_pid)"
    if check_process "${pid}"; then
        kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1
        local count=0
        while check_process "${pid}" && [ "${count}" -lt 20 ]; do
            sleep 1
            count=$((count + 1))
        done
        if check_process "${pid}"; then
            kill -KILL "${pid}" >> "${LOG_FILE}" 2>&1
        fi
    fi
    rm -f "${PID_FILE}"
    return 0
}

case "${1:-}" in
start)
    start_app
    ;;
stop)
    stop_app
    ;;
status)
    if status_app; then
        exit 0
    fi
    exit 3
    ;;
*)
    echo "Unknown command: ${1:-}" > "${TRIM_TEMP_LOGFILE}"
    exit 1
    ;;
esac
